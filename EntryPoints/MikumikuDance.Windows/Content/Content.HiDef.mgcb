# ── Shaders (HiDef: Defines=HIDEF, vs_4_0_level_9_1/ps_4_0_level_9_1, no preshader) ──

#begin Content/Shaders/Skinning.fx
/importer:EffectImporter
/processor:MikuMikuDance.Pipeline.Processors.MikuMikuDanceEffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=HIDEF
/build:Shaders/Skinning

#begin Content/Shaders/MMDPassThrough.fx
