<Project Sdk="MSBuild.Sdk.Extras">
	<PropertyGroup>
		<TargetFrameworks>net461</TargetFrameworks>
		<OutputType>WinExe</OutputType>

		<DefineConstants>WINDOWS</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>NU5128</NoWarn>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net461' ">
		<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.0.1641"></PackageReference>
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.0.1641"></PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Framework\MikumikuDance.Framework.BulletX\MikumikuDance.Framework.BulletX.csproj" />
		<ProjectReference Include="..\..\Framework\MikumikuDance.Framework.Core\MikumikuDance.Framework.Core.csproj" />
		<ProjectReference Include="..\..\Framework\MikumikuDance.Framework.Pipeline\MikumikuDance.Framework.Pipeline.csproj" />
		<ProjectReference Include="..\..\Framework\MikumikuDance.Framework.Primitives\MikumikuDance.Framework.Primitives.csproj" />
		<ProjectReference Include="..\..\Framework\MikumikuDance.Framework.Resources\MikumikuDance.Framework.Resources.csproj" />
		<ProjectReference Include="..\..\Framework\MikumikuDance.Framework.Xna\MikumikuDance.Framework.Xna.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Content\ext\*.*" />
		<Content Include="Content\eye2.bmp" />
		<Content Include="Icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<MonoGameContentReference Include="Content\Content.mgcb" />
	</ItemGroup>

	<Import Project="../../Build/profile111.props" Condition=" '$(TargetFramework)' == 'portable-net45+win8+wpa81' " />
	<Import Project="../../Build/sl5.props" Condition=" '$(TargetFramework)' == 'sl5' " />
	<Import Project="../../Build/net35.props" Condition=" '$(TargetFramework)' == 'net35' " />
	<Import Project="../../Build/net40.props" Condition=" '$(TargetFramework)' == 'net40' " />
	<Import Project="../../Build/netstandard2.0.props" Condition=" '$(TargetFramework)' == 'netstandard2.0' " />
	<Import Project="../../Build/net7.props" Condition=" '$(TargetFramework)' == 'net7' " />
	<Import Project="../../Build/net8.props" Condition=" '$(TargetFramework)' == 'net8' " />
	<Import Project="../../Build/net9.props" Condition=" '$(TargetFramework)' == 'net9' " />
</Project>