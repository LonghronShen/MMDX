<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MikumikuDance.Framework.Renderer.Xna</AssemblyName>
    <RootNamespace>MikumikuDance.Framework.Renderer.Xna</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MikumikuDance.Framework.Abstractions\MikumikuDance.Framework.Abstractions.csproj" />
    <ProjectReference Include="..\MikumikuDance.Framework.Xna\MikumikuDance.Framework.Xna.csproj" />
    <ProjectReference Include="..\MikumikuDance.Framework.Core\MikumikuDance.Framework.Core.csproj" />
  </ItemGroup>
  <!-- MonoGame.WindowsDX.9000 provides the Microsoft.Xna.Framework assemblies for net40 -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX.9000" Version="3.8.9102" />
  </ItemGroup>
</Project>
