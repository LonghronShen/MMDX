<Project>
  <PropertyGroup>
    <!-- Disable GitVersion entirely (no .git directory in extracted code) -->
    <GitVersion_NoGitVersion>true</GitVersion_NoGitVersion>
    <GitVersion_TaskEnabled>false</GitVersion_TaskEnabled>
    <!-- Skip auto-generated AssemblyInfo (avoids duplicate attributes with manual AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Skip all NuGet restore-generated package imports (avoids Bcl.Build MSB4062) -->
    <ExcludeRestorePackageImports>true</ExcludeRestorePackageImports>
  </PropertyGroup>
</Project>
